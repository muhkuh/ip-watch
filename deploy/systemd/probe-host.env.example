HOST=127.0.0.1
PORT=3001
PING_TIMEOUT_SEC=1
HTTP_TIMEOUT_MS=1500
ENABLE_HTTP_BY_DEFAULT=false
PROBE_API_TOKEN=

# Optional FRITZ! integration. Store real credentials only in the protected
# service environment file. A non-empty PROBE_API_TOKEN is required.
# FRITZ_ENABLED=false
# FRITZ_URL=https://<router-certificate-hostname>:<verified-tr064-tls-port>
# FRITZ_USERNAME=
# FRITZ_PASSWORD=
# FRITZ_CA_FILE=/etc/ip-watch/fritz-ca.pem
# FRITZ_POLL_INTERVAL_MS=60000
# FRITZ_REQUEST_TIMEOUT_MS=5000

# Optional patch-panel inventory. Requires Node 24.15+ and PROBE_API_TOKEN.
# INVENTORY_ENABLED=false
# INVENTORY_DB_PATH=/var/lib/ip-watch/inventory/inventory.sqlite
